{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyChronoManagedEC2",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances", "ec2:StartInstances", "ec2:ModifyInstanceAttribute"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {"aws:ResourceTag/chrono-architect:managed": "true"}
      }
    },
    {
      "Sid": "RegionBoundary",
      "Effect": "Deny",
      "Action": ["ec2:StopInstances", "ec2:StartInstances", "ec2:ModifyInstanceAttribute"],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": "us-east-1"}}
    }
  ]
}
