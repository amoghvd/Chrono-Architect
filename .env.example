CHRONO_AWS_REGION=us-east-1
# Replace this placeholder with the account ID returned by sts get-caller-identity.
CHRONO_ALLOWED_ACCOUNT_IDS=["123456789012"]
CHRONO_MANAGED_TAG_KEY=chrono-architect:managed
CHRONO_MANAGED_TAG_VALUE=true
CHRONO_APPROVAL_TTL_MINUTES=30
CHRONO_ANALYSIS_DAYS=14
CHRONO_AUDIT_DIR=audit-data
CHRONO_MCP_COMMAND=uvx
CHRONO_MCP_ARGS=["awslabs.aws-api-mcp-server@latest"]
CHRONO_MCP_TOOL=call_aws
# AWS credentials belong in local AWS profiles, never in this file.
CHRONO_ANALYZER_AWS_PROFILE=chrono-analyzer
CHRONO_EXECUTOR_AWS_PROFILE=chrono-executor
